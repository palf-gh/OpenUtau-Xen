<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <system:Boolean x:Key="IsDarkMode">false</system:Boolean>

  <Color x:Key="BackgroundColor">#F2F2EF</Color>
  <Color x:Key="BackgroundColorPointerOver">#E8E8E4</Color>
  <Color x:Key="BackgroundColorPressed">#DADAD5</Color>
  <Color x:Key="BackgroundColorDisabled">#CDCDC8</Color>

  <Color x:Key="ForegroundColor">#181818</Color>
  <Color x:Key="ForegroundColorPointerOver">#181818</Color>
  <Color x:Key="ForegroundColorPressed">#2A2A2A</Color>
  <Color x:Key="ForegroundColorDisabled">#808080</Color>

  <Color x:Key="BorderColor">#707070</Color>
  <Color x:Key="BorderColorPointerOver">#B0B0B0</Color>

  <Color x:Key="SystemAccentColor">#3344D6</Color>
  <!-- PointerOver -->
  <Color x:Key="SystemAccentColorLight1">#8E98EE</Color>
  <!-- Pressed -->
  <Color x:Key="SystemAccentColorDark1">#2433B0</Color>

  <Color x:Key="NeutralAccentColor">#A8A8A0</Color>
  <Color x:Key="NeutralAccentColorPointerOver">#8F8F88</Color>
  <Color x:Key="AccentColor1">#3344D6</Color>
  <Color x:Key="AccentColor2">#6B8F12</Color>
  <Color x:Key="AccentColor3">#4F6B0B</Color>
  
  <Color x:Key="TickLineColor">#B5B5AE</Color>
  <Color x:Key="BarNumberColor">#9C9C95</Color>
  <Color x:Key="FinalPitchColor">#C0C0C0</Color>
  <Color x:Key="TrackBackgroundAltColor">#E8E8E4</Color>

  <Color x:Key="WarningColor">#FFF4CE</Color>

  <!--Keyboard Background-->
  <Color x:Key="WhiteKeyColorLeft">Transparent</Color>
  <Color x:Key="WhiteKeyColorRight">Transparent</Color>
  <Color x:Key="WhiteKeyNameColor">#5C7410</Color>

  <Color x:Key="CenterKeyColorLeft">#EEF7C8</Color>
  <Color x:Key="CenterKeyColorRight">#E2F1A3</Color>
  <Color x:Key="CenterKeyNameColor">#4D5E0A</Color>

  <Color x:Key="BlackKeyColorLeft">#D9EF85</Color>
  <Color x:Key="BlackKeyColorRight">#CBE960</Color>
  <Color x:Key="BlackKeyNameColor">#101010</Color>

  <!--Xen: microtonal keys between naturals and accidentals; sub colour blue, see DESIGN.md-->
  <Color x:Key="BetweenKeyColorLeft">#C9CEF8</Color>
  <Color x:Key="BetweenKeyColorRight">#AEB6F4</Color>
  <Color x:Key="BetweenKeyNameColor">#1E2BA8</Color>
</ResourceDictionary>
