<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <system:Boolean x:Key="IsDarkMode">false</system:Boolean>

  <Color x:Key="BackgroundColor">#F2F2EF</Color>
  <Color x:Key="BackgroundColorPointerOver">#E8E8E4</Color>
  <Color x:Key="BackgroundColorPressed">#DADAD5</Color>
  <Color x:Key="BackgroundColorDisabled">#CDCDC8</Color>

  <Color x:Key="ForegroundColor">#181818</Color>
  <Color x:Key="ForegroundColorPointerOver">#181818</Color>
  <Color x:Key="ForegroundColorPressed">#2A2A2A</Color>
  <Color x:Key="ForegroundColorDisabled">#808080</Color>

  <Color x:Key="BorderColor">#707070</Color>
  <Color x:Key="BorderColorPointerOver">#B0B0B0</Color>

  <Color x:Key="SystemAccentColor">#4EA6EA</Color>
  <!-- PointerOver -->
  <Color x:Key="SystemAccentColorLight1">#90CAF9</Color>
  <!-- Pressed -->
  <Color x:Key="SystemAccentColorDark1">#1E88E5</Color>

  <Color x:Key="NeutralAccentColor">#ADA1B3</Color>
  <Color x:Key="NeutralAccentColorPointerOver">#948A99</Color>
  <Color x:Key="AccentColor1">#4EA6EA</Color>
  <Color x:Key="AccentColor2">#FF679D</Color>
  <Color x:Key="AccentColor3">#E62E6E</Color>
  
  <Color x:Key="TickLineColor">#AFA3B5</Color>
  <Color x:Key="BarNumberColor">#AFA3B5</Color>
  <Color x:Key="FinalPitchColor">#C0C0C0</Color>
  <Color x:Key="TrackBackgroundAltColor">#E8E8E4</Color>

  <Color x:Key="WarningColor">#FFF4CE</Color>

  <!--Keyboard Background-->
  <Color x:Key="WhiteKeyColorLeft">Transparent</Color>
  <Color x:Key="WhiteKeyColorRight">Transparent</Color>
  <Color x:Key="WhiteKeyNameColor">#FF347c</Color>

  <Color x:Key="CenterKeyColorLeft">#FFDDE6</Color>
  <Color x:Key="CenterKeyColorRight">#FFCEDC</Color>
  <Color x:Key="CenterKeyNameColor">#FF347C</Color>

  <Color x:Key="BlackKeyColorLeft">#FF71A3</Color>
  <Color x:Key="BlackKeyColorRight">#FF347C</Color>
  <Color x:Key="BlackKeyNameColor">#FFFFFF</Color>

  <!--Xen: microtonal keys between naturals and accidentals; brand lime, see DESIGN.md-->
  <Color x:Key="BetweenKeyColorLeft">#DDF08F</Color>
  <Color x:Key="BetweenKeyColorRight">#CBE960</Color>
  <Color x:Key="BetweenKeyNameColor">#101010</Color>
</ResourceDictionary>
