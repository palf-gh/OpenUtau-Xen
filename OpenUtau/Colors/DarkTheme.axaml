<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <system:Boolean x:Key="IsDarkMode">true</system:Boolean>
  
  <Color x:Key="BackgroundColor">#303030</Color>
  <Color x:Key="BackgroundColorPointerOver">#505050</Color>
  <Color x:Key="BackgroundColorPressed">#707070</Color>
  <Color x:Key="BackgroundColorDisabled">#404040</Color>

  <Color x:Key="ForegroundColor">#F2F2F2</Color>
  <Color x:Key="ForegroundColorPointerOver">#FCFCFC</Color>
  <Color x:Key="ForegroundColorPressed">#FFFFFF</Color>
  <Color x:Key="ForegroundColorDisabled">#A0A0A0</Color>

  <Color x:Key="BorderColor">#707070</Color>
  <Color x:Key="BorderColorPointerOver">#B0B0B0</Color>

  <Color x:Key="SystemAccentColor">#3344D6</Color>
  <!-- PointerOver -->
  <Color x:Key="SystemAccentColorLight1">#8E98EE</Color>
  <!-- Pressed -->
  <Color x:Key="SystemAccentColorDark1">#2433B0</Color>

  <Color x:Key="NeutralAccentColor">#808080</Color>
  <Color x:Key="NeutralAccentColorPointerOver">#A0A0A0</Color>
  <Color x:Key="AccentColor1">#3344D6</Color>
  <Color x:Key="AccentColor2">#6B8F12</Color>
  <Color x:Key="AccentColor3">#4F6B0B</Color>

  <Color x:Key="TickLineColor">#707070</Color>
  <Color x:Key="BarNumberColor">#D0D0D0</Color>
  <Color x:Key="FinalPitchColor">#D0D0D0</Color>
  <Color x:Key="TrackBackgroundAltColor">#404040</Color>
  
  <Color x:Key="WarningColor">#433519</Color>

  <!--Keyboard Background-->
  <Color x:Key="WhiteKeyColorLeft">#A9C640</Color>
  <Color x:Key="WhiteKeyColorRight">#CBE960</Color>
  <Color x:Key="WhiteKeyNameColor">#101010</Color>

  <Color x:Key="CenterKeyColorLeft">#B5C27E</Color>
  <Color x:Key="CenterKeyColorRight">#E2F1A3</Color>
  <Color x:Key="CenterKeyNameColor">#4D5E0A</Color>

  <Color x:Key="BlackKeyColorLeft">Transparent</Color>
  <Color x:Key="BlackKeyColorRight">Transparent</Color>
  <Color x:Key="BlackKeyNameColor">#FFFFFF</Color>

  <!--Xen: microtonal keys between naturals and accidentals; sub colour blue, see DESIGN.md-->
  <Color x:Key="BetweenKeyColorLeft">#2433B0</Color>
  <Color x:Key="BetweenKeyColorRight">#3344D6</Color>
  <Color x:Key="BetweenKeyNameColor">#FFFFFF</Color>
</ResourceDictionary>
